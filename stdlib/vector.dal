// Dalin L Standard Library — vector (real implementations)

fn vec_new() @ pure @ cpu { return [] }

fn vec_push(v, x) @ pure @ cpu { return v + [x] }

fn vec_pop(v) @ pure @ cpu {
    if len(v) == 0 { return None }
    return v[len(v) - 1]
}

fn vec_pop_back(v) @ pure @ cpu {
    if len(v) == 0 { return [] }
    return vec_slice(v, 0, len(v) - 1)
}

// 切片：返回 v[start..end) 的副本（end 超出范围时截断）
fn vec_slice(v, start, end) @ pure @ cpu {
    let out = []
    let i = start
    let limit = end
    if limit > len(v) { limit = len(v) }
    if start < 0 { i = 0 }
    while i < limit {
        out = vec_push(out, v[i])
        i = i + 1
    }
    return out
}

fn vec_len(v) @ pure @ cpu { return len(v) }

fn vec_get(v, i) @ pure @ cpu {
    if i < 0 || i >= len(v) { return None }
    return v[i]
}

fn vec_set(v, i, x) @ pure @ cpu {
    let new_v = []
    let j = 0
    while j < len(v) {
        let new_v = new_v + [if j == i { x } else { v[j] }]
        let j = j + 1
    }
    return new_v
}

fn vec_map(f, v) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(v)
    while i < n {
        let result = result + [f(v[i])]
        let i = i + 1
    }
    return result
}

fn vec_filter(pred, v) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(v)
    while i < n {
        if pred(v[i]) { result = result + [v[i]] }
        let i = i + 1
    }
    return result
}

fn vec_zip(a, b) @ pure @ cpu {
    let result = []
    let i = 0
    let n = if len(a) < len(b) { len(a) } else { len(b) }
    while i < n {
        result = result + [[a[i], b[i]]]
        let i = i + 1
    }
    return result
}

fn vec_flat(vs) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(vs)
    while i < n {
        let result = result + vs[i]
        let i = i + 1
    }
    return result
}

fn vec_reduce(acc, f, v) @ pure @ cpu {
    let i = 0
    let n = len(v)
    while i < n {
        let acc = f(acc, v[i])
        let i = i + 1
    }
    return acc
}

fn vec_each(f, v) @ pure @ cpu {
    let i = 0
    let n = len(v)
    while i < n {
        f(v[i])
        let i = i + 1
    }
    return v
}

fn vec_first(v) @ pure @ cpu {
    if len(v) == 0 { return None }
    return v[0]
}

fn vec_last(v) @ pure @ cpu {
    let n = len(v)
    if n == 0 { return None }
    return v[n - 1]
}

fn vec_empty(v) @ pure @ cpu { return len(v) == 0 }

fn vec_contains(v, x) @ pure @ cpu {
    let i = 0
    let n = len(v)
    while i < n {
        if v[i] == x { return true }
        let i = i + 1
    }
    return false
}
