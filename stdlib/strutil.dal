// Dalin L 标准库 — 字符串工具 (real implementations)

fn str_reverse(s) @ pure @ cpu { return strings::str_reverse(s) }

fn str_starts_with(s, prefix) @ pure @ cpu { return strings::str_starts_with(s, prefix) }

fn str_ends_with(s, suffix) @ pure @ cpu { return strings::str_ends_with(s, suffix) }

fn str_repeat(s, n) @ pure @ cpu {
    let result = ""
    let i = 0
    while i < n {
        let result = result + s
        let i = i + 1
    }
    return result
}

fn str_replace(s, from, to) @ pure @ cpu {
    if from == "" || !strings::str_contains(s, from) { return s }
    let idx = strings::str_index_of(s, from)
    if idx < 0 { return s }
    let before = ""
    let bi = 0
    while bi < idx {
        let before = before + s[bi]
        let bi = bi + 1
    }
    let after_end = idx + len(from)
    let after = ""
    let ai = after_end
    while ai < len(s) {
        let after = after + s[ai]
        let ai = ai + 1
    }
    return before + to + after
}

fn str_pad_left(s, len_val, ch) @ pure @ cpu {
    if len(s) >= len_val { return s }
    let padding = ""
    let pad_len = len_val - len(s)
    let i = 0
    while i < pad_len {
        let padding = padding + ch
        let i = i + 1
    }
    return padding + s
}

fn str_pad_right(s, len_val, ch) @ pure @ cpu {
    if len(s) >= len_val { return s }
    let padding = ""
    let pad_len = len_val - len(s)
    let i = 0
    while i < pad_len {
        let padding = padding + ch
        let i = i + 1
    }
    return s + padding
}

fn str_count(s, sub) @ pure @ cpu {
    if sub == "" { return 0 }
    let count = 0
    let pos = 0
    let s_len = len(s)
    let sub_len = len(sub)
    while pos <= s_len - sub_len {
        let found = false
        let j = 0
        while j < sub_len {
            if s[pos + j] == sub[j] { found = true } else { found = false; break }
            let j = j + 1
        }
        if found { let count = count + 1; let pos = pos + sub_len } else { let pos = pos + 1 }
    }
    return count
}

fn str_capitalize(s) @ pure @ cpu {
    if len(s) == 0 { return s }
    let first = strings::str_substring(s, 0, 1)
    let rest = ""
    if len(s) > 1 {
        let ri = 1
        while ri < len(s) {
            let rest = rest + s[ri]
            let ri = ri + 1
        }
    }
    return first
}

fn str_is_empty(s) @ pure @ cpu { return len(s) == 0 }

fn str_is_blank(s) @ pure @ cpu {
    let i = 0
    let n = len(s)
    while i < n {
        if s[i] != ' ' && s[i] != '\t' { return false }
        let i = i + 1
    }
    return true
}
