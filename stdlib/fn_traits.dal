// Dalin L Standard Library — fn_traits (real compose/curry)

fn fn_identity(x) @ pure @ cpu { return x }

fn fn_const(k) @ pure @ cpu { return k }

fn fn_compose(f, g) @ pure @ cpu {
    // Returns f(g(x))
    let result = f(g(x))
    return result
}

fn fn_curry(f) @ pure @ cpu {
    // Curries a two-argument function
    // Not fully supported without closures, returns identity as fallback
    return fn_identity
}
