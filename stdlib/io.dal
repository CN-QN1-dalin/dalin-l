// Dalin L Standard Library — io
// I/O 操作: read_file, write_file, print, println, read_line

fn io_read_file(path) @ io { return "" }
fn io_write_file(path, data) @ io { return true }
fn io_append_file(path, data) @ io { return true }
fn io_print(msg) @ io { return msg }
fn io_println(msg) @ io { return msg }
fn io_read_line() @ io { return "" }
fn io_stderr(msg) @ io { return msg }
fn io_flush() @ io { return 0 }
fn io_eof(stream) @ io { return false }
fn io_lines(path) @ io { return [] }
fn io_exists(path) @ io { return false }
fn io_delete(path) @ io { return true }
