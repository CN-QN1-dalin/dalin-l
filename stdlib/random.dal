// Dalin L — 随机数生成模块

fn random() @ pure @ cpu { return 0.0 }

fn rand_int(min, max) @ pure @ cpu { if min >= max { return min } let range = max - min; return min + int(random() * float(range)) }

fn rand_float(min, max) @ pure @ cpu { if min >= max { return min } return min + random() * (max - min) }

fn rand_choice(items) @ pure @ cpu { let n = len(items); if n == 0 { return null } let idx = rand_int(0, n); return items[idx] }

fn shuffle(arr) @ pure @ cpu {
    let result = arr
    let n = len(result)
    let i = n - 1
    while i > 0 {
        let j = rand_int(0, i + 1)
        let tmp = result[j]
        let new_result = []
        let k = 0
        while k < n {
            if k == i { let new_result = push(new_result, result[j]) }
            else if k == j { let new_result = push(new_result, result[i]) }
            else { let new_result = push(new_result, result[k]) }
            let k = k + 1
        }
        let result = new_result
        let i = i - 1
    }
    return result
}
