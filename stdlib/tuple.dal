// Dalin L Standard Library — tuple operations using list array

fn tuple_new(a, b) @ pure @ cpu { return [a, b] }

fn tuple_first(t) @ pure @ cpu { if len(t) > 0 { return t[0] } return null }

fn tuple_second(t) @ pure @ cpu { if len(t) > 1 { return t[1] } return null }

fn tuple_swap(t) @ pure @ cpu {
    let n = len(t)
    if n < 2 { return t }
    let result = []
    let i = 0
    while i < n {
        if i == 0 && n >= 2 { let result = push(result, t[1]) }
        else if i == 1 && n >= 2 { let result = push(result, t[0]) }
        else { let result = push(result, t[i]) }
        let i = i + 1
    }
    return result
}

fn tuple_to_list(t) @ pure @ cpu { return t }
