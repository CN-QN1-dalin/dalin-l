// Dalin L Standard Library — tuple operations using list array

fn tuple_new(a, b) @ pure @ cpu { return [a, b] }

fn tuple_first(t) @ pure @ cpu { if len(t) > 0 { return t[0] } return None }

fn tuple_second(t) @ pure @ cpu { if len(t) > 1 { return t[1] } return None }

fn tuple_swap(t) @ pure @ cpu {
    let n = len(t)
    if n < 2 { return t }
    let a = t[0]
    let b = t[1]
    let result = []
    let i = 0
    while i < n {
        let result = push(result, _swap_elem(t, i, a, b))
        let i = i + 1
    }
    return result
}

// 顶层 helper: 返回第 i 位应放入的元素 (规避 if 块内 let 不逃逸)
fn _swap_elem(t, i, a, b) @ pure @ cpu {
    if i == 0 { return b }
    if i == 1 { return a }
    return t[i]
}

fn tuple_to_list(t) @ pure @ cpu { return t }
