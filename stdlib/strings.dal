// @module strings — string manipulation functions

fn str_len(s) @ pure @ cpu {
    return len(s)
}

fn str_concat(a, b) @ pure @ cpu {
    return a + b
}

fn str_contains(haystack, needle) @ pure @ cpu {
    let h_len = len(haystack)
    let n_len = len(needle)
    if n_len == 0 { return true }
    if h_len < n_len { return false }
    let i = 0
    while i <= h_len - n_len {
        let match_found = true
        let j = 0
        while j < n_len {
            if haystack[i + j] != needle[j] {
                let match_found = false
            }
            let j = j + 1
        }
        if match_found { return true }
        let i = i + 1
    }
    return false
}

fn str_starts_with(s, prefix) @ pure @ cpu {
    let s_len = len(s)
    let p_len = len(prefix)
    if p_len > s_len { return false }
    if p_len == 0 { return true }
    let i = 0
    while i < p_len {
        if s[i] != prefix[i] { return false }
        let i = i + 1
    }
    return true
}

fn str_ends_with(s, suffix) @ pure @ cpu {
    let s_len = len(s)
    let suf_len = len(suffix)
    if suf_len > s_len { return false }
    if suf_len == 0 { return true }
    let start = s_len - suf_len
    let i = 0
    while i < suf_len {
        if s[start + i] != suffix[i] { return false }
        let i = i + 1
    }
    return true
}

fn str_substring(s, start_idx, end_idx) @ pure @ cpu {
    let s_len = len(s)
    let result = []
    let i = start_idx
    while i < end_idx {
        let result = push(result, s[i])
        let i = i + 1
    }
    return result
}

fn str_reverse(s) @ pure @ cpu {
    let s_len = len(s)
    let result = ""
    let i = s_len - 1
    while i >= 0 {
        let result = result + s[i]
        let i = i - 1
    }
    return result
}

fn str_index_of(s, target, start) @ pure @ cpu {
    let s_len = len(s)
    let t_len = len(target)
    if t_len == 0 { return 0 }
    if s_len < t_len { return -1 }
    let i = start
    while i <= s_len - t_len {
        let j = 0
        let found = true
        while j < t_len {
            if s[i + j] != target[j] {
                let found = false
            }
            let j = j + 1
        }
        if found { return i }
        let i = i + 1
    }
    return -1
}

fn str_replace(s, old, new) @ pure @ cpu {
    let idx = str_index_of(s, old, 0)
    if idx < 0 { return s }
    let before = str_substring(s, 0, idx)
    let after_start = idx + len(old)
    let after_end = len(s)
    let after = str_substring(s, after_start, after_end)
    return before + new + after
}

// --- 以下函数原仅存在于 strutil.dal，合并到本 canonical 模块以避免 API 缺失 (#662-4 去重) ---
// strutil.dal 已删除。str_reverse / str_starts_with / str_ends_with / str_replace 为重复定义，
// 本模块已含 canonical 实现，不再合并。

fn str_repeat(s, n) @ pure @ cpu {
    let result = ""
    let i = 0
    while i < n {
        let result = result + s
        let i = i + 1
    }
    return result
}

fn str_pad_left(s, len_val, ch) @ pure @ cpu {
    if len(s) >= len_val { return s }
    let padding = ""
    let pad_len = len_val - len(s)
    let i = 0
    while i < pad_len {
        let padding = padding + ch
        let i = i + 1
    }
    return padding + s
}

fn str_pad_right(s, len_val, ch) @ pure @ cpu {
    if len(s) >= len_val { return s }
    let padding = ""
    let pad_len = len_val - len(s)
    let i = 0
    while i < pad_len {
        let padding = padding + ch
        let i = i + 1
    }
    return s + padding
}

fn str_count(s, sub) @ pure @ cpu {
    if sub == "" { return 0 }
    let count = 0
    let pos = 0
    let s_len = len(s)
    let sub_len = len(sub)
    while pos <= s_len - sub_len {
        let found = false
        let j = 0
        while j < sub_len {
            if s[pos + j] == sub[j] { found = true } else { found = false; break }
            let j = j + 1
        }
        if found { let count = count + 1; let pos = pos + sub_len } else { let pos = pos + 1 }
    }
    return count
}

// str_capitalize: 将首字母大写（基于 ASCII 码位；其余字符原样保留）
// 修复原 strutil.dal 版本只返回首字符、丢失其余内容的 bug。
fn str_capitalize(s) @ pure @ cpu {
    if len(s) == 0 { return s }
    let first_char = s[0]
    let code = ord(first_char)
    let up_char = first_char
    if code >= 97 && code <= 122 {
        up_char = chr(code - 32)
    }
    let rest = ""
    let ri = 1
    while ri < len(s) {
        let rest = rest + s[ri]
        let ri = ri + 1
    }
    return str(up_char) + rest
}

fn str_is_empty(s) @ pure @ cpu { return len(s) == 0 }

fn str_is_blank(s) @ pure @ cpu {
    let i = 0
    let n = len(s)
    while i < n {
        if s[i] != ' ' && s[i] != '\t' { return false }
        let i = i + 1
    }
    return true
}
