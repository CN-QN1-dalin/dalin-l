// Dalin L Standard Library — range operations using builtin range()

fn range_new(start, end, step) @ pure @ cpu {
    let r = []
    let i = start
    while i < end {
        let r = push(r, i)
        let i = i + step
    }
    return r
}

fn range_from(start, end) @ pure @ cpu {
    return range_new(start, end, 1)
}

fn range_includes(r, val) @ pure @ cpu {
    let i = 0
    let n = len(r)
    while i < n {
        if r[i] == val { return true }
        let i = i + 1
    }
    return false
}

fn range_len(r) @ pure @ cpu { return len(r) }

fn range_to_list(r) @ pure @ cpu { return r }
