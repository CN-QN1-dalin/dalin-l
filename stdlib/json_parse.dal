// Dalin L Core — json_parse (fixed number parsing)

fn json_parse(json_str) @ pure @ cpu {
    let trimmed = _trim_whitespace(json_str)
    // Dalin L 中 map 即「[k, v] 二元组数组」，空 map 用空数组表示
    if trimmed == "{}" || trimmed == "" { return [] }
    if trimmed == "[]" { return [] }
    let content = _json_strip_outer(trimmed)
    return _json_parse_flat(content)
}

fn _trim_whitespace(s) @ pure @ cpu {
    let start = 0
    let end = len(s) - 1
    let i = 0
    while i < len(s) {
        if s[i] != ' ' && s[i] != '\t' && s[i] != '\n' && s[i] != '\r' { start = i; break }
        let i = i + 1
    }
    let j = 0
    let li = len(s) - 1
    while j <= li {
        if s[li - j] != ' ' && s[li - j] != '\t' && s[li - j] != '\n' && s[li - j] != '\r' { end = li - j; break }
        let j = j + 1
    }
    if end < start { return "" }
    let result = ""
    let k = start
    while k <= end {
        let result = result + s[k]
        let k = k + 1
    }
    return result
}

fn _json_strip_outer(s) @ pure @ cpu {
    if s == "{}" || s == "[]" { return "" }
    let first = s[0]
    if first == '{' || first == '[' { return _json_substring(s, 1, len(s) - 1) }
    return s
}

fn _json_substring(s, start, end) @ pure @ cpu {
    let result = ""
    let i = start
    while i < end && i < len(s) {
        let result = result + s[i]
        let i = i + 1
    }
    return result
}

fn _json_parse_flat(content) @ pure @ cpu {
    // Dalin L 的 map = [[k, v], ...]（值为二元组的数组），不能用 `result[key] = v`
    // （解释器仅支持数组下标赋值）。故以数组拼接累积键值对。
    let result = []
    let parts = _json_split_commas(content)
    let i = 0
    let n = len(parts)
    while i < n {
        let part = parts[i]
        let colon_pos = _json_find_char(part, ':')
        if colon_pos > 0 {
            let key = _json_strip_quotes(_json_trim_key(part, colon_pos))
            let value_str = _json_trim_value(part, colon_pos)
            result = result + [[key, _json_parse_value(value_str)]]
        }
        let i = i + 1
    }
    return result
}

fn _json_split_commas(s) @ pure @ cpu {
    let parts = []
    let current = ""
    let depth = 0
    let i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        if c == '{' || c == '[' { depth = depth + 1 }
        if c == '}' || c == ']' { depth = depth - 1 }
        if c == ',' && depth == 0 {
            parts = parts + [current]
            current = ""
        } else {
            let current = current + c
        }
        let i = i + 1
    }
    if current != "" { parts = parts + [current] }
    return parts
}

fn _json_find_char(s, ch) @ pure @ cpu {
    let i = 0
    let n = len(s)
    while i < n {
        if s[i] == ch { return i }
        let i = i + 1
    }
    return -1
}

fn _json_trim_key(s, colon_pos) @ pure @ cpu {
    let result = ""
    let i = 0
    while i < colon_pos {
        if s[i] != ' ' && s[i] != '\t' {
            let result = result + s[i]
        }
        let i = i + 1
    }
    return result
}

fn _json_trim_value(s, colon_pos) @ pure @ cpu {
    let i = colon_pos + 1
    let result = ""
    while i < len(s) {
        let result = result + s[i]
        let i = i + 1
    }
    return result
}

fn _json_strip_quotes(s) @ pure @ cpu {
    if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
        let result = ""
        let i = 1
        while i < len(s) - 1 {
            let result = result + s[i]
            let i = i + 1
        }
        return result
    }
    return s
}

fn _json_parse_value(v) @ pure @ cpu {
    let trimmed = _json_trim_all_space(v)
    if trimmed == "null" || trimmed == "" { return None }
    if trimmed == "true" { return true }
    if trimmed == "false" { return false }
    // 嵌套结构：数组与对象递归解析（构成完整 JSON 解析器）
    if trimmed[0] == '[' { return _json_parse_array(_json_strip_outer(trimmed)) }
    if trimmed[0] == '{' { return _json_parse_flat(_json_strip_outer(trimmed)) }
    let num = _json_parse_number(trimmed)
    // 有效数：_json_parse_number 对非法输入返回 -1（整数哨兵）。
    // 负数会落到 num < 0 分支，故用 _json_is_number 二次确认是否属于合法数字串。
    if num >= 0 || (num < 0 && _json_is_number(trimmed)) { return num }
    if trimmed[0] == '"' {
        let result = ""
        let i = 1
        while i < len(trimmed) - 1 {
            let result = result + trimmed[i]
            let i = i + 1
        }
        return result
    }
    return trimmed
}

// 解析 JSON 数组：[v1, v2, ...] → Dalin L 列表（元素递归 _json_parse_value）
fn _json_parse_array(content) @ pure @ cpu {
    if content == "" { return [] }
    let parts = _json_split_commas(content)
    let result = []
    let i = 0
    let n = len(parts)
    while i < n {
        result = result + [_json_parse_value(parts[i])]
        let i = i + 1
    }
    return result
}

fn _json_is_number(s) @ pure @ cpu {
    let n = len(s)
    if n == 0 { return false }
    let i = 0
    let seen_dot = false
    while i < n {
        let c = s[i]
        if i == 0 && c == '-' { } // 负号仅在首位
        else if c == '.' {
            if seen_dot { return false }
            let seen_dot = true
        }
        else if ord(c) >= ord('0') && ord(c) <= ord('9') { }
        else { return false }
        let i = i + 1
    }
    return true
}

fn _json_trim_all_space(s) @ pure @ cpu {
    let result = ""
    let i = 0
    while i < len(s) {
        if s[i] != ' ' && s[i] != '\t' {
            let result = result + s[i]
        }
        let i = i + 1
    }
    return result
}

// 解析数字（整数与浮点，支持负号）。非法输入返回 -1（整数哨兵，
// 由 _json_parse_value 配合 _json_is_number 区分「合法负数」与「非法」）。
fn _json_parse_number(s) @ pure @ cpu {
    let is_num = true
    let has_digit = false
    let has_dot = false
    let i = 0
    let n = len(s)
    while i < n {
        let c = s[i]
        // Dalin L: Char 不支持 >= / <=，统一用 ord() 比较码位
        if ord(c) >= ord('0') && ord(c) <= ord('9') { has_digit = true }
        else if c == '.' && !has_dot { has_dot = true }
        else if c == '-' && i == 0 { } // 负号只允许出现在首位
        else { is_num = false; break }
        let i = i + 1
    }
    if !is_num || !has_digit { return -1 }

    let neg = false
    let start = 0
    if s[0] == '-' { let neg = true; let start = 1 }
    let int_part = 0.0
    let frac_part = 0.0
    let frac_len = 0
    let in_frac = false
    let i = start
    while i < n {
        let c = s[i]
        if c == '.' {
            let in_frac = true
        } else if ord(c) >= ord('0') && ord(c) <= ord('9') {
            let digit = ord(c) - ord('0')
            if in_frac {
                let frac_len = frac_len + 1
                let frac_part = frac_part * 10.0 + digit
            } else {
                let int_part = int_part * 10.0 + digit
            }
        }
        let i = i + 1
    }
    let value = int_part
    if frac_len > 0 {
        let denom = 1.0
        let k = 0
        while k < frac_len { let denom = denom * 10.0; let k = k + 1 }
        let value = int_part + frac_part / denom
    }
    if neg { return -value }
    return value
}

fn json_to_string(data) @ pure @ cpu {
    return _json_serialize(data, 0)
}

fn _json_serialize(val, indent) @ pure @ cpu {
    let t = type_of(val)
    if t == "map" { return _json_serialize_map(val) }
    if t == "list" { return _json_serialize_list(val) }
    if t == "string" { return "\"" + val + "\"" }
    if val == true { return "true" }
    if val == false { return "false" }
    if val == None { return "null" }
    return str(val)
}

fn _json_serialize_map(m) @ pure @ cpu {
    let result = "{"
    let i = 0
    let n = len(m)
    while i < n {
        if i > 0 { result = result + ", " }
        let k = m[i][0]
        let v = m[i][1]
        result = result + "\"" + k + "\": " + _json_serialize(v, indent + 1)
        let i = i + 1
    }
    result = result + "}"
    return result
}

fn _json_serialize_list(lst) @ pure @ cpu {
    let result = "["
    let i = 0
    let n = len(lst)
    while i < n {
        if i > 0 { result = result + ", " }
        result = result + _json_serialize(lst[i], indent + 1)
        let i = i + 1
    }
    result = result + "]"
    return result
}
