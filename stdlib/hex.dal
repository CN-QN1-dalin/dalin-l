// Module: hex — 完整 Hex 编解码
// 依赖运行时内建: ord / chr
// 设计: 输入为字符串, 逐字符取字节值 (ord) 转 16 进制; 解码逐字符查值转回字节.
// 规避: 不使用 map 字面量 / map 赋值 (不支持), Char 比较 (用 ord 转 Int),
//       if 内 && 组合比较 (用嵌套 if), if 块内 let 重绑定 (均在顶层/提前 return).

fn hex_encode(s) @ pure @ cpu {
    let table = "0123456789abcdef"
    let result = ""
    let i = 0
    let n = len(s)
    while i < n {
        let b = ord(s[i])
        let hi = b / 16
        let lo = b % 16
        let result = result + table[hi]
        let result = result + table[lo]
        let i = i + 1
    }
    return result
}

fn hex_decode(s) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(s)
    while i + 1 < n {
        let hi = _hex_digit_val(s[i])
        let lo = _hex_digit_val(s[i + 1])
        result = result + [hi * 16 + lo]
        let i = i + 2
    }
    return result
}

fn hex_to_int(s) @ pure @ cpu {
    let result = 0
    let i = 0
    let n = len(s)
    while i < n {
        let result = result * 16 + _hex_digit_val(s[i])
        let i = i + 1
    }
    return result
}

fn hex_from_int(n) @ pure @ cpu {
    if n == 0 { return "0" }
    let table = "0123456789abcdef"
    let digits = []
    let val = n
    while val > 0 {
        digits = [table[val % 16]] + digits
        let val = val / 16
    }
    let result = ""
    let i = 0
    while i < len(digits) {
        let result = result + digits[i]
        let i = i + 1
    }
    return result
}

fn _hex_digit_val(c) @ pure @ cpu {
    let o = ord(c)
    if o >= 48 {
        if o <= 57 { return o - 48 }
    }
    if o >= 97 {
        if o <= 102 { return o - 87 }
    }
    if o >= 65 {
        if o <= 70 { return o - 55 }
    }
    return 0
}
