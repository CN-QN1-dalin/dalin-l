// Dalin L Standard Library — encoding utilities
// 高层编码: URL / JSON. 字节级 hex / base64 委托给 hex.dal / base64.dal 的规范实现,
// 避免重复定义带来的名字冲突 (旧版本使用不支持的语法, 且在加载顺序下覆盖规范实现).
//
// 规避项:
//  - 不使用 >> << & | (不支持), break/continue (不支持)
//  - Char 直接比较 (c >= 'A') 改用 ord(c) 后做 Int 区间判断
//  - if 块内 let 重绑定不跨块逃逸 -> url_decode 改用尾递归传 index

// --- hex 兼容别名 (委托 hex.dal 规范实现) ---
fn encode_hex(data) @ pure @ cpu { return hex_encode(data) }
fn decode_hex(s) @ pure @ cpu { return hex_decode(s) }

// --- base64 兼容别名 (委托 base64.dal 规范实现) ---
fn encode_base64(data) @ pure @ cpu { return base64_encode(data) }
fn decode_base64(data) @ pure @ cpu { return base64_decode(data) }

// --- URL 编码 ---
// 非保留字符 (unreserved) 原样保留, 其余按 %XX 转义 (XX = 字节值的 hex).
fn url_encode(s) @ pure @ cpu {
    let result = ""
    let i = 0
    let n = len(s)
    while i < n {
        let o = ord(s[i])
        let c = s[i]
        let un = 0
        if o >= 65 {
            if o <= 90 { let un = 1 }      // A-Z
        }
        if o >= 97 {
            if o <= 122 { let un = 1 }     // a-z
        }
        if o >= 48 {
            if o <= 57 { let un = 1 }      // 0-9
        }
        if o == 45 { let un = 1 }          // '-'
        if o == 95 { let un = 1 }          // '_'
        if o == 46 { let un = 1 }          // '.'
        if o == 126 { let un = 1 }         // '~'
        if un == 1 {
            result = result + c
        } else {
            result = result + "%" + hex_from_int(o)
        }
        let i = i + 1
    }
    return result
}

// --- URL 解码 (尾递归, 逐字符推进 index, 规避 if 块内 let 不逃逸) ---
fn url_decode(s) @ pure @ cpu {
    return _url_decode_loop(s, 0, len(s), "")
}

fn _url_decode_loop(s, i, n, result) @ pure @ cpu {
    if i >= n { return result }
    if s[i] == '%' {
        if i + 2 < n {
            let code = hex_to_int(str(s[i + 1]) + str(s[i + 2]))
            return _url_decode_loop(s, i + 3, n, result + chr(code))
        }
    }
    return _url_decode_loop(s, i + 1, n, result + s[i])
}

// --- JSON 编码 (委托 json_parse 模块) ---
fn encode_json(data) @ pure @ cpu { return json_to_string_impl(data) }

fn json_to_string_impl(data) @ pure @ cpu { return json_parse::json_to_string(data) }
