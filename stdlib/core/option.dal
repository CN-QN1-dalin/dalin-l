// Dalin L Core — option
// Option 类型工具: Some/None 辅助函数

fn option_is_none(opt) @ pure @ cpu { return opt == null }
fn option_is_some(opt) @ pure @ cpu { return !(opt == null) }
fn option_get(opt, default_val) @ pure @ cpu { if (opt == null) { return default_val } else { return opt } }
fn option_map(opt, f) @ pure @ cpu { if (opt == null) { return null } else { return f(opt) } }
fn option_and_then(opt, f) @ pure @ cpu { if (opt == null) { return null } else { return f(opt) } }
fn option_unwrap_or_panic(opt, msg) @ pure @ cpu { if (opt == null) { return "option is none: " + msg } else { return opt } }
