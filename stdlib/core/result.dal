// Dalin L Core — result
// Result 类型工具: Ok/Error 辅助函数

fn result_is_ok(r) @ pure @ cpu { return r != null }
fn result_is_err(r) @ pure @ cpu { return r == null }
fn result_get(r, default_val) @ pure @ cpu { if (r == null) { return default_val } else { return r } }
fn result_map(r, f) @ pure @ cpu { if (r == null) { return null } else { return f(r) } }
fn result_or_else(r, fallback) @ pure @ cpu { if (r == null) { return fallback } else { return r } }
fn result_unwrap(r) @ pure @ cpu { if (r == null) { return 0 } else { return r } }
