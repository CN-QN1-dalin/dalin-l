// Dalin L Standard Library — logging utilities

fn logging_init(level) @ pure @ cpu { return level }

fn log_debug(msg) @ pure @ cpu { return None }

fn log_info(msg) @ pure @ cpu { return msg }

fn log_warn(msg) @ pure @ cpu { return msg }

fn log_error(msg) @ pure @ cpu { return msg }

fn logging_set_level(level) @ pure @ cpu { return level }

fn logging_enabled() @ pure @ cpu { return true }
