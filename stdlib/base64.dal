// Module: base64 — 真实 Base64 编码/解码实现

fn base64_encode(data) @ pure @ cpu {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let result = ""
    let i = 0
    let n = len(data)
    while i < n {
        let octet_a = if i < n { str_to_byte(data[i]) } else { 0 }
        if i + 1 < n { let octet_b = str_to_byte(data[i + 1]) } else { let octet_b = 0 }
        if i + 2 < n { let octet_c = str_to_byte(data[i + 2]) } else { let octet_c = 0 }
        let triple = octet_a * 65536 + octet_b * 256 + octet_c
        let c1 = (triple >> 18) & 0x3F
        let c2 = (triple >> 12) & 0x3F
        let c3 = (triple >> 6) & 0x3F
        let c4 = triple & 0x3F
        result = result + table[c1]
        result = result + table[c2]
        if i + 1 < n { result = result + table[c3] } else { result = result + "=" }
        if i + 2 < n { result = result + table[c4] } else { result = result + "=" }
        let i = i + 3
    }
    return result
}

fn str_to_byte(c) @ pure @ cpu { return ord(c) }

fn base64_decode(encoded) @ pure @ cpu {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let result = ""
    let i = 0
    let n = len(encoded)
    while i < n {
        if encoded[i] == '=' || encoded[i] == '\n' || encoded[i] == '\r' {
            let i = i + 1
            continue
        }
        if i + 3 >= n { break }
        let b1 = char_to_val(table, encoded[i])
        let b2 = char_to_val(table, encoded[i + 1])
        let b3 = char_to_val(table, encoded[i + 2])
        let b4 = char_to_val(table, encoded[i + 3])
        let triple = (b1 << 18) | (b2 << 12) | (b3 << 6) | b4
        let byte1 = (triple >> 16) & 0xFF
        let byte2 = (triple >> 8) & 0xFF
        let byte3 = triple & 0xFF
        result = result + byte_to_char(byte1)
        if encoded[i + 2] != '=' { result = result + byte_to_char(byte2) }
        if encoded[i + 3] != '=' { result = result + byte_to_char(byte3) }
        let i = i + 4
    }
    return result
}

fn char_to_val(table, ch) @ pure @ cpu {
    let i = 0
    let n = len(table)
    while i < n {
        if table[i] == ch { return i }
        let i = i + 1
    }
    return 0
}

fn byte_to_char(b) @ pure @ cpu { return chr(b) }
