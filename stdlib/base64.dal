// Module: base64 — 真实 Base64 编解码 (纯算术, 无位运算)
// 依赖运行时内建: ord / chr / str
// 设计: 用 / % * 模拟位段 (24-bit triple 拆 4 个 6-bit index); 跳过 '='/空白用 helper 返回新串.
// 规避: 不使用 >> << & | (不支持), break/continue (不支持),
//       if 块内 let 重绑定 (accum 均在 while 顶层; 余下分组用 if + 提前 return).

fn base64_encode(data) @ pure @ cpu {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let result = ""
    let i = 0
    let n = len(data)
    while i + 2 < n {
        let a = ord(data[i])
        let b = ord(data[i + 1])
        let c = ord(data[i + 2])
        let triple = a * 65536 + b * 256 + c
        result = result + table[triple / 262144]
        result = result + table[(triple / 4096) % 64]
        result = result + table[(triple / 64) % 64]
        result = result + table[triple % 64]
        let i = i + 3
    }
    // 余下 0/1/2 字节, 带 '=' 填充 (在 if 内提前 return, 规避 let 不逃逸)
    if n - i == 1 {
        let a = ord(data[i])
        let triple = a * 65536
        result = result + table[triple / 262144]
        result = result + table[(triple / 4096) % 64]
        result = result + "=="
        return result
    }
    if n - i == 2 {
        let a = ord(data[i])
        let b = ord(data[i + 1])
        let triple = a * 65536 + b * 256
        result = result + table[triple / 262144]
        result = result + table[(triple / 4096) % 64]
        result = result + table[(triple / 64) % 64]
        result = result + "="
        return result
    }
    return result
}

fn base64_decode(encoded) @ pure @ cpu {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let clean = _b64_clean(encoded)
    let result = ""
    let i = 0
    let m = len(clean)
    while i + 3 < m {
        let v0 = _b64_val(table, clean[i])
        let v1 = _b64_val(table, clean[i + 1])
        let v2 = _b64_val(table, clean[i + 2])
        let v3 = _b64_val(table, clean[i + 3])
        let triple = v0 * 262144 + v1 * 4096 + v2 * 64 + v3
        result = result + _byte_str((triple / 65536) % 256)
        result = result + _byte_str((triple / 256) % 256)
        result = result + _byte_str(triple % 256)
        let i = i + 4
    }
    let rem = m - i
    if rem == 3 {
        let v0 = _b64_val(table, clean[i])
        let v1 = _b64_val(table, clean[i + 1])
        let v2 = _b64_val(table, clean[i + 2])
        let triple = v0 * 262144 + v1 * 4096 + v2 * 64
        result = result + _byte_str((triple / 65536) % 256)
        result = result + _byte_str((triple / 256) % 256)
        return result
    }
    if rem == 2 {
        let v0 = _b64_val(table, clean[i])
        let v1 = _b64_val(table, clean[i + 1])
        let triple = v0 * 262144 + v1 * 4096
        result = result + _byte_str((triple / 65536) % 256)
        return result
    }
    return result
}

// 过滤掉 '=' 与空白, 返回纯 base64 字符串 (accum 在 while 顶层, 用 helper 返回追加值)
fn _b64_clean(s) @ pure @ cpu {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let ch = s[i]
        let keep = _b64_keep(ch)
        out = out + _b64_maybe(ch, keep)
        let i = i + 1
    }
    return out
}

fn _b64_keep(ch) @ pure @ cpu {
    let o = ord(ch)
    if o == 61 { return 0 }   // '='
    if o == 32 { return 0 }   // ' '
    if o == 10 { return 0 }   // '\n'
    if o == 13 { return 0 }   // '\r'
    return 1
}

fn _b64_maybe(ch, keep) @ pure @ cpu {
    if keep == 0 { return "" }
    return str(ch)
}

fn _b64_val(table, ch) @ pure @ cpu {
    let i = 0
    let n = len(table)
    while i < n {
        if table[i] == ch { return i }
        let i = i + 1
    }
    return 0
}

fn _byte_str(b) @ pure @ cpu {
    return str(chr(b))
}
