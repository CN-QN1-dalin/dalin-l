// @module map — map operations using arrays of [key, value] pairs
// Uses let-shadowing pattern and builtins: len, push

fn map_new() @ pure @ cpu { return [] }

fn map_put(m, key, val) @ pure @ cpu {
    return push(m, [key, val])
}

fn map_get(m, key, default) @ pure @ cpu {
    let i = 0
    let n = len(m)
    while i < n {
        if len(m[i]) >= 2 {
            if m[i][0] == key { return m[i][1] }
        }
        let i = i + 1
    }
    return default
}

fn map_has_key(m, key) @ pure @ cpu {
    let i = 0
    let n = len(m)
    while i < n {
        if len(m[i]) >= 2 {
            if m[i][0] == key { return true }
        }
        let i = i + 1
    }
    return false
}

fn map_remove(m, key) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(m)
    while i < n {
        if len(m[i]) >= 2 {
            if m[i][0] != key {
                let result = push(result, m[i])
            }
        }
        let i = i + 1
    }
    return result
}

fn map_keys(m) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(m)
    while i < n {
        if len(m[i]) >= 1 {
            let result = push(result, m[i][0])
        }
        let i = i + 1
    }
    return result
}

fn map_values(m) @ pure @ cpu {
    let result = []
    let i = 0
    let n = len(m)
    while i < n {
        if len(m[i]) >= 2 {
            let result = push(result, m[i][1])
        }
        let i = i + 1
    }
    return result
}

fn map_len(m) @ pure @ cpu {
    return len(m)
}

fn map_is_empty(m) @ pure @ cpu {
    return len(m) == 0
}

fn map_clear(m) @ pure @ cpu {
    return []
}
