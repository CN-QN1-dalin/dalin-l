// Dalin L Standard Library — testing utilities

fn test_assert(cond) @ pure @ cpu {
    if cond { return true }
    return false
}

fn test_eq(a, b) @ pure @ cpu { return a == b }

fn test_ne(a, b) @ pure @ cpu { return a != b }

fn test_ok() @ pure @ cpu { return true }

fn test_fail(msg) @ pure @ cpu { return msg }

fn test_count_pass() @ pure @ cpu { return 0 }

fn test_count_fail() @ pure @ cpu { return 0 }

fn test_summary() @ pure @ cpu { return "test passed" }
