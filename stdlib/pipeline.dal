// Dalin L Standard Library — pipeline (real implementation)

fn pipeline_create() @ pure @ cpu { return [] }

fn pipeline_add_step(pipe, step) @ pure @ cpu { return pipe + [step] }

fn pipeline_execute(pipe, input) @ pure @ cpu {
    let result = input
    let i = 0
    let n = len(pipe)
    while i < n {
        let result = pipe[i](result)
        let i = i + 1
    }
    return result
}
