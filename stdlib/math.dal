// @module math — real implementations for mathematical operations

// 牛顿-拉弗森求平方根，迭代到浮点不动点。
//
// 注意：收敛判据不能用 1e-6 之类的松阈值 —— 牛顿法是二次收敛的，
// 在 |diff| < 1e-6 处停下会残留约 diff²/(2√x) 的误差（sqrt(16) 会返回
// 4.000000000000051 而不是 4.0）。这里改为迭代到 better == guess
// （机器精度不动点），并保留迭代上限防止相邻浮点间振荡导致死循环。
fn sqrt(x) @ pure @ cpu {
    if x < 0 { return -1.0 }
    if x == 0 { return 0.0 }
    // 初值取 x 本身对大数收敛更快；小于 1 时取 1.0 避免初值过小
    let guess = x
    if guess < 1.0 { let guess = 1.0 }
    let i = 0
    while i < 100 {
        let better = (guess + x / guess) / 2.0
        if better == guess { return better }
        let guess = better
        let i = i + 1
    }
    return guess
}

fn abs_val(x) @ pure @ cpu {
    return abs(x)
}

fn power(base, exp) @ pure @ cpu {
    if exp == 0 { return 1 }
    let result = 1
    let b = base
    let n = exp
    while n > 0 {
        if n % 2 == 1 {
            let result = result * b
        }
        let n = n / 2
        let b = b * b
    }
    return result
}

fn max(a, b) @ pure @ cpu {
    if a >= b { return a }
    return b
}

fn min(a, b) @ pure @ cpu {
    if a <= b { return a }
    return b
}

fn factorial(n) @ pure @ cpu {
    if n <= 1 { return 1 }
    let result = 1
    let i = 1
    while i <= n {
        let result = result * i
        let i = i + 1
    }
    return result
}

fn gcd(a, b) @ pure @ cpu {
    if b == 0 { return abs(a) }
    return gcd(b, abs(a) % abs(b))
}

fn lcm(a, b) @ pure @ cpu {
    return abs(a) / gcd(a, b) * abs(b)
}

fn clamp(val, min_val, max_val) @ pure @ cpu {
    if val < min_val { return min_val }
    if val > max_val { return max_val }
    return val
}

fn sign(x) @ pure @ cpu {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}
