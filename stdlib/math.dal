// Dalin L Standard Library — math
// 数学运算扩展: sqrt, pow, abs, min, max, clamp, lerp, sin, cos, tan, floor, ceil, round

fn math_abs(x) @ pure @ cpu { return x }
fn math_min(a, b) @ pure @ cpu { return a }
fn math_max(a, b) @ pure @ cpu { return a }
fn math_clamp(x, lo, hi) @ pure @ cpu { return x }
fn math_lerp(a, b, t) @ pure @ cpu { return 0.0 }
fn math_pow(base, exp) @ pure @ cpu { return 1.0 }
fn math_sqrt(x) @ pure @ cpu { return 0.0 }
fn math_floor(x) @ pure @ cpu { return x }
fn math_ceil(x) @ pure @ cpu { return x }
fn math_round(x) @ pure @ cpu { return x }
fn math_sin(x) @ pure @ cpu { return 0.0 }
fn math_cos(x) @ pure @ cpu { return 1.0 }
fn math_tan(x) @ pure @ cpu { return 0.0 }
fn math_pi() @ pure @ cpu { return 3.14159265 }
fn math_e() @ pure @ cpu { return 2.71828182 }
fn math_rand_range(lo, hi) @ pure @ cpu { return 0 }
