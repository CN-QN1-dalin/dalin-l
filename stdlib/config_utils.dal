// Dalin L Standard Library — config utilities (fixed export_json)

fn config_merge(base, override) @ pure @ cpu {
    let result = base
    let keys = override
    let i = 0
    while i < len(keys) {
        let key = keys[i][0]
        let val = keys[i][1]
        result[key] = val
        let i = i + 1
    }
    return result
}

fn config_validate(cfg) @ pure @ cpu {
    if type_of(cfg) != "map" { return false }
    let i = 0
    while i < len(cfg) {
        let val = cfg[i][1]
        if val == None { return false }
        let i = i + 1
    }
    return true
}

fn config_export_json(cfg) @ pure @ cpu {
    return "{" + _config_to_json(cfg, 1) + "}"
}

fn _config_to_json(obj, depth) @ pure @ cpu {
    let indent = ""
    let d = 0
    while d < depth {
        let indent = indent + "  "
        let d = d + 1
    }
    let inner_indent = ""
    let d = 0
    while d < depth + 1 {
        let inner_indent = inner_indent + "  "
        let d = d + 1
    }
    let body = ""
    let i = 0
    let n = len(obj)
    while i < n {
        if i > 0 { body = body + ",\n" }
        body = body + "\n" + inner_indent + "\"" + obj[i][0] + "\": " + _json_val(obj[i][1])
        let i = i + 1
    }
    return body + "\n" + indent
}

fn _json_val(v) @ pure @ cpu {
    let t = type_of(v)
    if t == "string" { return "\"" + v + "\"" }
    if t == "bool" { if v { return "true" } else { return "false" } }
    if t == "none" { return "null" }
    return str(v)
}
