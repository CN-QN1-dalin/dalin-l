// Dalin L Standard Library — Result type utilities

fn result_ok(val) @ pure @ cpu {
    return [true, val, None]
}

fn result_err(err_val) @ pure @ cpu {
    return [false, None, err_val]
}

fn result_is_ok(r) @ pure @ cpu {
    if len(r) > 0 { return r[0] }
    return false
}

fn result_is_err(r) @ pure @ cpu {
    return !result_is_ok(r)
}

fn result_get(r, default) @ pure @ cpu {
    if result_is_ok(r) && len(r) > 1 { return r[1] }
    return default
}

fn result_get_error(r) @ pure @ cpu {
    if !result_is_ok(r) && len(r) > 2 { return r[2] }
    return None
}

fn result_map(r, transform) @ pure @ cpu {
    if result_is_ok(r) && len(r) > 1 {
        let val = r[1]
        return result_ok(val)
    }
    return r
}

fn result_and_then(r, other) @ pure @ cpu {
    if result_is_ok(r) { return other }
    return r
}

fn result_or_else(r, fallback) @ pure @ cpu {
    if result_is_ok(r) { return r }
    return fallback
}
