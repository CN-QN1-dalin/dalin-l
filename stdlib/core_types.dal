// Dalin L 标准库 — 核心类型系统 (real type checking)
//
// 注意：is_int / is_float / is_bool / is_string / is_list / is_map / is_fn
// 现在由解释器内建提供（见 interpreter.rs call_builtin）。此前的 stdlib 实现存在
// 两个致命缺陷：
//   1) is_* 与 type_of 互相递归 → 对 list/map 调用 type_of 会无限循环栈溢出；
//   2) is_int 用 `c >= '0'` 比较 Char，而 Dalin L 的 Char 不支持 >= / <= → 崩溃。
// 现改为直接调用内建谓词，type_of 不再递归、不再做 Char 比较。
// is_map 约定：Array 且为空或所有元素均为二元组 [k, v]（与 json.dal 的 map 表示一致）。

fn type_of(x) @ pure @ cpu {
    if x == None { return "none" }
    if is_bool(x) { return "bool" }
    if is_int(x) { return "int" }
    if is_float(x) { return "float" }
    if is_string(x) { return "string" }
    if is_char(x) { return "char" }
    if is_map(x) { return "map" }
    if is_list(x) { return "list" }
    return "unknown"
}

fn can_convert(from, to) @ pure @ cpu {
    if from == to { return true }
    // int -> float
    if from == "int" && to == "float" { return true }
    // any -> string
    if to == "string" { return true }
    return false
}

fn to_string(val) @ pure @ cpu { return str(val) }

fn to_int(val) @ pure @ cpu {
    if is_int(val) { return val }
    if is_string(val) {
        let s = val
        let result = 0
        let i = 0
        let neg = false
        if s[0] == '-' { let neg = true; let i = 1 }
        let n = len(s)
        while i < n {
            let d = ord(s[i]) - ord('0')
            result = result * 10 + d
            let i = i + 1
        }
        if neg { return -result }
        return result
    }
    return 0
}

fn to_float(val) @ pure @ cpu {
    if is_float(val) { return val }
    if is_int(val) { return val * 1.0 }
    return 0.0
}
