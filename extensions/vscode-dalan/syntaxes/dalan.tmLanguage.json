{
  "name": "Dalin L",
  "scopeName": "source.dalan",
  "fileTypes": ["dal"],
  "patterns": [
    { "include": "#line-comment" },
    { "include": "#block-comment" },
    { "include": "#string-literal" },
    { "include": "#char-literal" },
    { "include": "#number-literal" },
    { "include": "#bool-literal" },
    { "include": "#attribute-bracket" },
    { "include": "#channel-annotation" },
    { "include": "#at-attribute" },
    { "include": "#function-call" },
    { "include": "#keyword-statement" },
    { "include": "#keyword-control" },
    { "include": "#keyword-type" },
    { "include": "#keyword-op" },
    { "include": "#operators" },
    { "include": "#identifier" }
  ],
  "repository": {
    "line-comment": {
      "begin": "//",
      "end": "$",
      "name": "comment.line.double-slash.dalan"
    },
    "block-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.dalan"
    },
    "string-literal": {
      "name": "string.quoted.double.dalan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.dalan", "match": "\\\\." }
      ]
    },
    "char-literal": {
      "name": "string.quoted.single.dalan",
      "begin": "'",
      "end": "'"
    },
    "number-literal": {
      "patterns": [
        {
          "name": "constant.numeric.integer.dalan",
          "match": "\\b(0|[1-9][0-9]*)\\b"
        },
        {
          "name": "constant.numeric.float.dalan",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.range.dalan",
          "match": "\\b(0|[1-9][0-9]*)\\.\\.(0|[1-9][0-9]*)\\b"
        }
      ]
    },
    "bool-literal": {
      "name": "constant.language.boolean.dalan",
      "match": "\\b(true|false)\\b"
    },
    "null-literal": {
      "name": "constant.language.null.dalan",
      "match": "\\b(null|none)\\b"
    },
    "attribute-bracket": {
      "name": "meta.attribute.bracket.dalan",
      "begin": "#\\[",
      "end": "\\]",
      "patterns": [
        { "name": "entity.name.tag.attribute.bracket.dalan", "match": "[a-zA-Z_]\\w*" },
        { "include": "#string-literal" },
        { "include": "#number-literal" }
      ]
    },
    "channel-annotation": {
      "begin": "@(pure|io|cpu|net|perceive|observe|reflect|act|gov|latency|llm|verified|test|bench)",
      "end": "(?=;|\\{|\\}|,|\\)|$|\\n|->|=)",
      "name": "meta.channel-annotation.dalan",
      "patterns": [
        {
          "name": "entity.other.attribute-name.channel.dalan",
          "match": "[a-zA-Z_]\\w*"
        }
      ]
    },
    "at-attribute": {
      "begin": "@(?!(pure|io|cpu|net|perceive|observe|reflect|act|gov|latency|llm|verified|test|bench))",
      "end": "(?=;|\\{|\\}|,|\\)|$|\\n|->|=)",
      "name": "meta.at-attribute.dalan",
      "patterns": [
        {
          "name": "variable.parameter.annotation.dalan",
          "match": "[a-zA-Z_]\\w*"
        }
      ]
    },
    "keyword-statement": {
      "name": "keyword.statement.dalan",
      "match": "\\b(fn|let|mut|const|return|use|module|export|trait|impl|struct|enum|type|as|channel|spawn|async|try|catch|assert)\\b"
    },
    "keyword-control": {
      "name": "keyword.control.dalan",
      "match": "\\b(if|else|for|in|while|match|case|break|continue|yield)\\b"
    },
    "keyword-type": {
      "name": "keyword.type.dalan",
      "match": "\\b(Int|Float|String|Bool|Void|List|Map|Option|Result|Any|Unit|Channel|Process|CognitiveLoop|GovernancePolicy)\\b"
    },
    "keyword-keyword": {
      "name": "keyword.operator.assignment.dalan",
      "match": "\\b(ok|error|pub)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.dalan",
          "match": "->"
        },
        {
          "name": "keyword.operator.double-arrow.dalan",
          "match": "=>"
        },
        {
          "name": "keyword.operator.pipe.dalan",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.douledot.dalan",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.dalan",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.dalan",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.dalan",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assign.dalan",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.questionmark.dalan",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.at.dalan",
          "match": "@"
        },
        {
          "name": "keyword.operator.dollar.dalan",
          "match": "\\$"
        }
      ]
    },
    "function-call": {
      "name": "meta.function-call.dalan",
      "begin": "\\b([a-zA-Z_]\\w*)\\s*\\(",
      "beginCaptures": {
        "1": { "name": "entity.name.function.call.dalan" }
      },
      "end": "\\)",
      "patterns": [
        { "include": "#string-literal" },
        { "include": "#number-literal" },
        { "include": "#bool-literal" },
        { "include": "#channel-annotation" },
        { "include": "#at-attribute" }
      ]
    },
    "identifier": {
      "name": "variable.other.readwrite.dalan",
      "match": "\\b[a-zA-Z_]\\w*\\b"
    }
  }
}
