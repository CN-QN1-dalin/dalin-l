{
  "name": "Dalin L",
  "scopeName": "source.dalan",
  "fileTypes": ["dal"],
  "patterns": [
    { "include": "#line-comment" },
    { "include": "#block-comment" },
    { "include": "#string-literal" },
    { "include": "#number-literal" },
    { "include": "#boolean-literal" },
    { "include": "#keyword" },
    { "include": "#channel-annotation" },
    { "include": "#attribute" },
    { "include": "#function-declaration" },
    { "include": "#function-call" },
    { "include": "#identifier" }
  ],
  "repository": {
    "line-comment": {
      "name": "comment.line.number-sign.dalan",
      "begin": "#",
      "end": "$"
    },
    "block-comment": {
      "name": "comment.block.dalan",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "string-literal": {
      "name": "string.quoted.double.dalan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.dalan", "match": "\\\\." }
      ]
    },
    "number-literal": {
      "patterns": [
        {
          "name": "constant.numeric.integer.dalan",
          "match": "\\b(0|[1-9][0-9]*)\\b"
        },
        {
          "name": "constant.numeric.float.dalan",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        }
      ]
    },
    "boolean-literal": {
      "name": "constant.language.boolean.dalan",
      "match": "\\b(true|false|null|none)\\b"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.dalan",
          "match": "\\b(if|else|for|while|switch|case|break|continue|return|yield)\\b"
        },
        {
          "name": "keyword.function.dalan",
          "match": "\\b(fn|async|await)\\b"
        },
        {
          "name": "keyword.variable.dalan",
          "match": "\\b(let|mut|const|val|var)\\b"
        },
        {
          "name": "keyword.type.dalan",
          "match": "\\b(int|float|string|bool|void|option|result|list|map|any)\\b"
        },
        {
          "name": "keyword.module.dalan",
          "match": "\\b(use|module|package|import|export|as)\\b"
        },
        {
          "name": "keyword.operator.dalan",
          "match": "(==|!=|<=|>=|<|>|&&|\\|\\||!|=|\\+|\\-|\\*|/|%|=>|->)"
        },
        {
          "name": "keyword.operator.pipe.dalan",
          "match": "\\|>"
        }
      ]
    },
    "channel-annotation": {
      "name": "meta.channel-annotation.dalan",
      "begin": "@(pure|io|cpu|net|perceive|observe|reflect|act|gov|latency|llm|verified|test|bench)",
      "end": "(?=[\\s,;(])",
      "patterns": [
        {
          "name": "entity.other.attribute-name.channel.dalan",
          "match": "\\w+"
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.dalan",
      "begin": "@(?!pure|io|cpu|net|perceive|observe|reflect|act|gov|latency|llm|verified|test|bench)",
      "end": "(?=[\\s,;(])",
      "patterns": [
        {
          "name": "variable.parameter.annotation.dalan",
          "match": "\\w+"
        }
      ]
    },
    "function-declaration": {
      "name": "meta.function.dalan",
      "begin": "\\b(fn)\\s+(\\w+)",
      "beginCaptures": {
        "1": { "name": "keyword.function.dalan" },
        "2": { "name": "entity.name.function.dalan" }
      },
      "end": "\\{|$",
      "patterns": [
        { "include": "#string-literal" },
        { "include": "#number-literal" },
        { "include": "#keyword" },
        { "include": "#channel-annotation" },
        { "include": "#attribute" },
        {
          "name": "variable.parameter.function.dalan",
          "match": "\\b[a-zA-Z_]\\w*"
        }
      ]
    },
    "function-call": {
      "name": "meta.function-call.dalan",
      "begin": "\\b([a-zA-Z_]\\w*)\\s*\\(",
      "beginCaptures": {
        "1": { "name": "entity.name.function.call.dalan" }
      },
      "end": "\\)",
      "patterns": [
        { "include": "#string-literal" },
        { "include": "#number-literal" },
        { "include": "#boolean-literal" },
        { "include": "#keyword" }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "name": "variable.other.readwrite.dalan",
          "match": "\\b[a-zA-Z_]\\w*\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
