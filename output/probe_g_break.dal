// 探针 G：break / continue 语言级控制流全场景验证

// 1. while + break：i==3 时终止，累加 0+1+2 = 3
fn t_while_break() @ pure @ cpu {
    let i = 0
    let sum = 0
    while i < 10 {
        if i == 3 { break }
        sum = sum + i
        i = i + 1
    }
    return sum
}

// 2. while + continue：跳过偶数，累加 1+3+5+7+9 = 25
fn t_while_continue() @ pure @ cpu {
    let i = 0
    let sum = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 0 { continue }
        sum = sum + i
    }
    return sum
}

// 3. 嵌套循环：break 只终止最内层。外层 3 轮 × 内层 2 次累加 = 6
fn t_nested_break() @ pure @ cpu {
    let outer = 0
    let count = 0
    while outer < 3 {
        let inner = 0
        while inner < 5 {
            if inner == 2 { break }
            count = count + 1
            inner = inner + 1
        }
        outer = outer + 1
    }
    return count
}

// 4. 循环内 return 仍能穿透 break 拦截层，直接返回 99
fn t_return_through_loop() @ pure @ cpu {
    let i = 0
    while i < 10 {
        if i == 4 { return 99 }
        i = i + 1
    }
    return -1
}

// 5. for + break：数组遇到 0 停止，累加 5+7 = 12
fn t_for_break() @ pure @ cpu {
    let total = 0
    for v in [5, 7, 0, 100] {
        if v == 0 { break }
        total = total + v
    }
    return total
}

// 6. for + continue：跳过负数，累加 3+4 = 7
fn t_for_continue() @ pure @ cpu {
    let total = 0
    for v in [3, -1, 4, -9] {
        if v < 0 { continue }
        total = total + v
    }
    return total
}

fn main() @ pure @ cpu {
    println("[1] while+break     =", t_while_break(), "(expect 3)")
    println("[2] while+continue  =", t_while_continue(), "(expect 25)")
    println("[3] nested break    =", t_nested_break(), "(expect 6)")
    println("[4] return in loop  =", t_return_through_loop(), "(expect 99)")
    println("[5] for+break       =", t_for_break(), "(expect 12)")
    println("[6] for+continue    =", t_for_continue(), "(expect 7)")
}
